#!/usr/bin/env bash
set -u

# Redirect all stdout & stderr to log and console
exec > >(tee -a /var/log/user-data.log | logger -t user-data -s 2>/dev/console) 2>&1
echo "=== Starting CampusHub EC2 Baseline User Data Initialization ==="
date

# 1. Install prerequisites (Amazon Linux 2023 ships AWS CLI v2 pre-installed)
echo "Installing OS packages..."
dnf install -y python3.11 git unzip jq || dnf install -y python3 git unzip jq || true

# 2. Setup application directory
APP_DIR="/opt/campushub"
mkdir -p "$APP_DIR/backend"
cd "$APP_DIR"

# 3. Download CampusHub backend code package from S3
echo "Downloading backend package from s3://${media_bucket_id}/_deploy/backend.zip..."
aws s3 cp "s3://${media_bucket_id}/_deploy/backend.zip" /tmp/backend.zip --region "${aws_region}" || true

if [ -f /tmp/backend.zip ]; then
  unzip -q -o /tmp/backend.zip -d "$APP_DIR/backend"
  echo "Backend package extracted successfully."
else
  echo "WARNING: /tmp/backend.zip not found! Creating minimal app fallback..."
  mkdir -p "$APP_DIR/backend/app"
fi

# 3b. Tesseract OCR for reading mess menus: the layer the Lambdas use, unpacked into /opt (lib, bin, share;
#     the python/ folder is skipped because the venv below has the same packages).
%{ if tesseract_key != "" ~}
echo "Installing the Tesseract OCR layer..."
if aws s3 cp "s3://${media_bucket_id}/${tesseract_key}" /tmp/tesseract-layer.zip --region "${aws_region}"; then
  unzip -q -o /tmp/tesseract-layer.zip -x 'python/*' -d /opt
  echo /opt/lib > /etc/ld.so.conf.d/campushub-tesseract.conf
  ldconfig
  echo "Tesseract installed."
else
  echo "WARNING: could not download the Tesseract layer; mess menus can't be read from files."
fi
%{ endif ~}

# 3c. ONNX models for category suggestion (Buy & Sell, Lost & Found) and course-feedback sentiment:
#     static data, unpacked straight into backend/models (app/categories_suggest.py's model_dir()).
%{ if ml_models_key != "" ~}
echo "Installing the category-suggestion/sentiment models..."
if aws s3 cp "s3://${media_bucket_id}/${ml_models_key}" /tmp/ml-models.zip --region "${aws_region}"; then
  mkdir -p "$APP_DIR/backend/models"
  unzip -q -o /tmp/ml-models.zip -d "$APP_DIR/backend/models"
  echo "Category-suggestion/sentiment models installed."
else
  echo "WARNING: could not download the ML models; category suggestion and sentiment analysis are unavailable."
fi
%{ endif ~}

# 4. Retrieve database credentials from Secrets Manager
echo "Retrieving database credentials from Secrets Manager..."
SECRET_JSON=$(aws secretsmanager get-secret-value \
  --secret-id "${db_secret_arn}" \
  --region "${aws_region}" \
  --query SecretString \
  --output text 2>/dev/null || echo "{}")

DB_PASS=$(echo "$SECRET_JSON" | jq -r '.password // .db_password // empty')

%{ if redis_enabled ~}
# 4b. Retrieve the Redis AUTH token from Secrets Manager (kept out of the .env file as a raw
#     value for the same reason as the DB password: it can contain characters that are unsafe to
#     splice into a connection string unescaped).
echo "Retrieving Redis AUTH token from Secrets Manager..."
REDIS_AUTH_TOKEN=$(aws secretsmanager get-secret-value \
  --secret-id "${redis_auth_secret_arn}" \
  --region "${aws_region}" \
  --query SecretString \
  --output text 2>/dev/null || echo "")
%{ endif ~}

# 5. Write .env configuration file. CAMPUSHUB_DATABASE_URL carries no password: app/db.py fetches
#    user+password from CAMPUSHUB_DATABASE_SECRET_ARN itself and they replace whatever the URL has.
#    (The raw password must never be spliced into a URL unescaped -- it can contain characters like
#    ':' '@' '#' that corrupt the connection string's parsing.)
cat <<EOF > "$APP_DIR/backend/.env"
CAMPUSHUB_DATABASE_URL=postgresql://${db_user}@${db_host}:5432/${db_name}
CAMPUSHUB_DATABASE_SECRET_ARN=${db_secret_arn}
CAMPUSHUB_AUTH_MODE=cognito
CAMPUSHUB_COGNITO_REGION=${aws_region}
CAMPUSHUB_COGNITO_USER_POOL_ID=${cognito_user_pool_id}
CAMPUSHUB_COGNITO_APP_CLIENT_ID=${cognito_app_client_id}
CAMPUSHUB_S3_BUCKET=${media_bucket_id}
CAMPUSHUB_S3_REGION=${aws_region}
CAMPUSHUB_S3_ENDPOINT_URL=https://s3.${aws_region}.amazonaws.com
CAMPUSHUB_CORS_ALLOW_ORIGINS=["*"]
CAMPUSHUB_ORIGIN_VERIFY_SECRET=${origin_verify_header}
CAMPUSHUB_DB_POOL_MAX_SIZE=${db_pool_max_size}
%{ if redis_enabled ~}
CAMPUSHUB_REDIS_HOST=${redis_host}
CAMPUSHUB_REDIS_PORT=${redis_port}
CAMPUSHUB_REDIS_TLS=true
EOF
# The AUTH token is appended separately (see the DB password note above: never splice a secret with
# unescaped special characters into the heredoc body itself -- append it as its own line instead).
echo "CAMPUSHUB_REDIS_AUTH_TOKEN=$REDIS_AUTH_TOKEN" >> "$APP_DIR/backend/.env"
%{ else ~}
EOF
%{ endif ~}

chmod 600 "$APP_DIR/backend/.env"

# 6. Setup Python virtual environment & dependencies
PYTHON_BIN=$(command -v python3.11 || command -v python3)
echo "Using Python: $($PYTHON_BIN --version)"
$PYTHON_BIN -m venv "$APP_DIR/venv"
"$APP_DIR/venv/bin/pip" install --upgrade pip setuptools wheel --quiet

echo "Installing backend dependencies..."
"$APP_DIR/venv/bin/pip" install --no-cache-dir "fastapi==0.115.6" "uvicorn[standard]==0.34.0" "asyncpg==0.30.0" "pydantic==2.10.4" "pydantic-settings==2.7.1" "PyJWT[crypto]==2.10.1" "cryptography==50.0.2" "boto3==1.37.38" --quiet

if [ -f "$APP_DIR/backend/requirements.txt" ]; then
  "$APP_DIR/venv/bin/pip" install --no-cache-dir -r "$APP_DIR/backend/requirements.txt" --quiet || true
fi

# 7. Initialize Database Schema if not already loaded in RDS
if [ -f "$APP_DIR/backend/db/schema.sql" ] && [ -n "$DB_PASS" ]; then
  echo "Checking database schema initialization..."
  CAMPUSHUB_DB_PASS="$DB_PASS" "$APP_DIR/venv/bin/python" -c "
import asyncio, asyncpg, os
async def init():
    try:
        # password passed as its own argument, never spliced into the DSN string (it can contain
        # URL-delimiter characters like ':' '@' '#' that would corrupt a hand-built connection URL)
        conn = await asyncpg.connect(host='${db_host}', port=5432, user='${db_user}',
                                     password=os.environ['CAMPUSHUB_DB_PASS'], database='${db_name}', timeout=10)
        exists = await conn.fetchval(\"SELECT to_regclass('users');\")
        if not exists:
            print('Loading schema.sql into database...')
            with open('$APP_DIR/backend/db/schema.sql') as f:
                await conn.execute(f.read())
            ref = '$APP_DIR/backend/db/reference-data.sql'
            if os.path.exists(ref):
                with open(ref) as f:
                    await conn.execute(f.read())
            print('Database tables created successfully.')
        else:
            print('Database tables already exist.')
        await conn.close()
    except Exception as e:
        print('DB Init note:', e)
asyncio.run(init())
" || true
fi

# 8. Create systemd unit service
cat <<'SERVICE' > /etc/systemd/system/campushub.service
[Unit]
Description=CampusHub FastAPI Backend (Baseline EC2)
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/campushub/backend
EnvironmentFile=/opt/campushub/backend/.env
ExecStart=/opt/campushub/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
SERVICE

# Set ownership
chown -R ec2-user:ec2-user "$APP_DIR"

# 9. Start and enable systemd service
systemctl daemon-reload
systemctl enable --now campushub.service

# 10. Health check poll
echo "Polling health check on port 8000..."
for i in {1..30}; do
  if curl -sf http://127.0.0.1:8000/api/v1/health >/dev/null 2>&1; then
    echo "CampusHub FastAPI backend is UP and HEALTHY on port 8000!"
    break
  fi
  sleep 2
done

echo "=== CampusHub EC2 Baseline User Data Completed Successfully ==="
date
