# Settings for a server: the EC2 baseline (docker run --env-file .env) or, as environment
# variables, the Lambda function. For your own machine, copy .env.local.example instead.

# RDS Proxy endpoint. Leave the password out and point DATABASE_SECRET_ARN at the database
# credentials in Secrets Manager; the user and password are read from there.
CAMPUSHUB_DATABASE_URL=postgresql://campushub@your-rds-proxy-endpoint:5432/campushub
CAMPUSHUB_DATABASE_SECRET_ARN=

# Sign-in with Cognito ID tokens. Dev sign-in can't be turned on from this file's settings.
CAMPUSHUB_AUTH_MODE=cognito
CAMPUSHUB_COGNITO_REGION=ap-south-1
CAMPUSHUB_COGNITO_USER_POOL_ID=
CAMPUSHUB_COGNITO_APP_CLIENT_ID=

# Uploads bucket. Credentials come from the Lambda / EC2 IAM role, not from this file.
CAMPUSHUB_S3_BUCKET=campushub-uploads
CAMPUSHUB_S3_REGION=ap-south-1

# CloudFront in front of the bucket (optional). Set all three: file links are signed with
# this key pair and expire. Inject the private key from Secrets Manager.
# CAMPUSHUB_CDN_BASE_URL=https://d1234abcd.cloudfront.net
# CAMPUSHUB_CDN_KEY_PAIR_ID=
# CAMPUSHUB_CDN_PRIVATE_KEY=

# Browser origins allowed to call the API (a JSON list), e.g. the web app's CloudFront domain.
CAMPUSHUB_CORS_ALLOW_ORIGINS=["https://your-web-app-domain"]

# Inside Lambda these default to: pool size 2, Swagger docs off.
# CAMPUSHUB_DB_POOL_MAX_SIZE=2
# CAMPUSHUB_DOCS_ENABLED=false
