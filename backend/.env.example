# Copy to .env for local development. In AWS, set these as Lambda environment variables
# (put the database password in Secrets Manager rather than in plain text).

CAMPUSHUB_DATABASE_URL=postgresql://campushub:campushub@localhost:5432/campushub

# Local: "dev" lets you act as any IISc user with the header  X-Dev-User: you@iisc.ac.in
# AWS:   "cognito" (the app refuses to start in Lambda with "dev")
CAMPUSHUB_AUTH_MODE=dev
CAMPUSHUB_COGNITO_REGION=ap-south-1
CAMPUSHUB_COGNITO_USER_POOL_ID=
CAMPUSHUB_COGNITO_APP_CLIENT_ID=

# Local MinIO from docker-compose. In AWS: leave S3_ENDPOINT_URL empty and set the real bucket.
CAMPUSHUB_S3_BUCKET=campushub-uploads
CAMPUSHUB_S3_REGION=ap-south-1
CAMPUSHUB_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
# CloudFront distribution in front of the bucket (optional locally)
# CAMPUSHUB_CDN_BASE_URL=https://d1234abcd.cloudfront.net

# Lambda: keep the pool tiny and let RDS Proxy pool connections
# CAMPUSHUB_DB_POOL_MAX_SIZE=2
