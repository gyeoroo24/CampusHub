# Your own machine only: Postgres and MinIO from docker-compose, plus dev sign-in.
# Copy to .env. Never use these settings on a server.

CAMPUSHUB_DATABASE_URL=postgresql://campushub:campushub@localhost:5432/campushub

# Dev sign-in: act as any IISc user by sending the header  X-Dev-User: you@iisc.ac.in
# It works only for requests from this machine, and both lines are needed.
CAMPUSHUB_AUTH_MODE=dev
CAMPUSHUB_ALLOW_DEV_AUTH=true

# MinIO from docker-compose (uvicorn's --env-file exports the two AWS_ keys to boto3, and
# docker compose uses them as MinIO's login).
CAMPUSHUB_S3_BUCKET=campushub-uploads
CAMPUSHUB_S3_REGION=ap-south-1
CAMPUSHUB_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Sharing this server with other machines on your Wi-Fi (see README, "Share it on your network"):
# - CAMPUSHUB_DEV_AUTH_KEY: a long random value; teammates send it as the X-Dev-Key header.
# - CAMPUSHUB_S3_ENDPOINT_URL: http://<this laptop's IP>:9000, so their upload and photo links work.
# - AWS_SECRET_ACCESS_KEY: a long random value, because MinIO's port is then open to the network.
# CAMPUSHUB_DEV_AUTH_KEY=
# CAMPUSHUB_S3_ENDPOINT_URL=http://192.168.1.20:9000
