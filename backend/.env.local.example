# Your own machine only: Postgres and MinIO from docker-compose, plus dev sign-in.
# Copy to .env. Never use these settings on a server.

CAMPUSHUB_DATABASE_URL=postgresql://campushub:campushub@localhost:5432/campushub

# Dev sign-in: act as any IISc user by sending the header  X-Dev-User: you@iisc.ac.in
# It works only for requests from this machine, and both lines are needed.
CAMPUSHUB_AUTH_MODE=dev
CAMPUSHUB_ALLOW_DEV_AUTH=true

# MinIO from docker-compose (uvicorn's --env-file exports the two AWS_ keys to boto3).
CAMPUSHUB_S3_BUCKET=campushub-uploads
CAMPUSHUB_S3_REGION=ap-south-1
CAMPUSHUB_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
