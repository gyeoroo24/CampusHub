# AWS Lambda container image (the PRD's main compute target).
# Build:  docker build -f Dockerfile.lambda -t campushub-api-lambda .
# Lambda handler: app.main.handler
FROM public.ecr.aws/lambda/python:3.12

COPY requirements.txt ${LAMBDA_TASK_ROOT}/
RUN pip install --no-cache-dir -r ${LAMBDA_TASK_ROOT}/requirements.txt --target ${LAMBDA_TASK_ROOT}

# The category-suggestion model (34 MB; app/categories_suggest.py), checksum-checked.
COPY scripts/fetch_match_models.py /tmp/
RUN python /tmp/fetch_match_models.py --suggest-only ${LAMBDA_TASK_ROOT}/models && rm /tmp/fetch_match_models.py

COPY app ${LAMBDA_TASK_ROOT}/app

# Reading mess menus from files needs the `tesseract` program, which the Lambda base image doesn't
# have. Without it, POST /mess-menus/extract says so and moderators type or paste the meals; to turn it
# on, add a Tesseract Lambda layer (or build it into this image) so `tesseract` is on the PATH.

CMD ["app.main.handler"]
