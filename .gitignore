# ==========================================
# Terraform Git Ignore
# ==========================================

# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude sensitive variables files
*.tfvars
*.tfvars.json
!*.tfvars.example

# Ignore override files as they are usually personal
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore packaged lambda archives
*.zip
**/lambda_src/*.zip

# OS and IDE files
.DS_Store
Thumbs.db
.idea/
.vscode/
